# Copy this file to ~/.claude-evernote-sync/config.toml and customize.
#
# This config picks WHERE conversations sync. Credentials (Gmail app password,
# Evernote email address, OR developer token) go in credentials.json — see README.

[evernote]
# Sync backend: "email" or "api".
#
#   "email" — Send via Evernote's email-to-note feature. Works today.
#             Requires Gmail SMTP credentials in credentials.json.
#
#   "api"   — Send via Evernote's NoteStore API. Currently blocked: Evernote
#             suspended new developer-token issuance in Jan 2026. Use only if
#             you have an existing token, or once Evernote reopens access.
backend = "email"

# Recommended setup: organize per-project notebooks inside a single Evernote
# stack so the sidebar stays tidy. With notebook_prefix set, every session
# routes to "<prefix><bucket>" automatically — no per-project config needed.
# Example: a session in /Users/you/Documents/git/myapp routes to "convos_myapp".
#
# Set notebook_prefix = "" to disable; everything falls back to notebook_name.
notebook_prefix = "convos_"

# Catch-all notebook. Used only when notebook_prefix is empty, or for sessions
# whose bucket can't be derived (rare edge case).
notebook_name = "convos_default"

# IMPORTANT for "email" backend: you must create each target notebook in
# Evernote MANUALLY before first sync. Email-to-note silently falls back to
# your default notebook if the @notebook reference doesn't match an existing
# one. The "api" backend auto-creates notebooks.

# Required only when backend = "api"
developer_token = ""
api_host = "www.evernote.com"

[scan]
# Where Claude Code stores its session JSONL files.
projects_dir = "~/.claude/projects"

# Sync sessions modified within the last N days. Keep small for fast runs;
# bump (or use --backfill) for initial historical sync.
days_back = 2

[display]
# Timezone for timestamps inside the rendered notes (the "Update at HH:MM"
# marker on append emails, per-message timestamps, session start/end times).
#
# Accepts:
#   - "UTC" (default — no conversion)
#   - "local" — your Mac's current system timezone
#   - any IANA name, e.g. "America/Los_Angeles", "Europe/London", "Asia/Tokyo"
#
# IANA timezones handle DST automatically (PST/PDT, GMT/BST, etc.) — prefer
# them over a fixed offset string.
timezone = "UTC"

[render]
# How to handle Claude Code sub-agent (Task-tool) transcripts. They live in
# <session>/subagents/ and otherwise each become their own note titled with the
# verbose task prompt the sub-agent was given.
#
#   "keep"     — one note per sub-agent, titled from its .meta.json description
#                (e.g. "Audit pooling and perf hotspots"). Default.
#   "suppress" — skip sub-agent transcripts; only top-level sessions sync.
subagent_notes = "keep"

[grouping]
# By default, each session is rolled up under its git repo root's basename.
# A session in a non-git directory uses that directory's name.
#
# Use rollup_overrides to absorb multiple repos under a single parent. Any
# session whose cwd is under one of these paths will be grouped under that
# path's basename instead of its individual repo.
rollup_overrides = [
    # "/Users/yourname/Documents/git/some-workspace",
]

# Map a bucket to a specific Evernote notebook name. Buckets not listed here
# follow the notebook_prefix pattern above (e.g. "convos_<bucket>"), or fall
# back to notebook_name if no prefix is set. An explicit override is never
# re-prefixed — the value here is used verbatim.
#
# Keys are bucket names (= git repo root basename, or basename of a
# rollup_overrides path). Quote any key containing characters outside
# [A-Za-z0-9_-].
[notebook_overrides]
# "myapp" = "Special Notebook Name"
# personal_blog = "Writing"
